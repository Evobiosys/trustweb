// Review wave 42: the tools import app modules (community_data, event_plan), whose types reach DOM code and enums: DOM lib on, erasableSyntaxOnly off
// (it flagged the app's enums, which node never loads). The runtime guard is the unit test that boots server.ts under plain node (mcp_parity.test.mjs).
{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": false,
    "typeRoots": ["../../node_modules/.pnpm/@types+node@22.20.1/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src", "../trustweb/src/env.d.ts", "../trustweb/src/record_diff.ts", "../trustweb/src/billing/pricing.ts"]
}
