+	# --- TrustWeb short connect links (wave 5, services-api-contract "Short links") ---
+	# POST /link stores a long connect url, GET /l/<id> answers 302 to it. The id and the url are capabilities:
+	# log_skip keeps these requests out of Caddy's access log. It does NOT silence the error log, which can still name
+	# the request URI when the upstream fails (accepted risk, see the wave 5 services report).
+	handle /link {
+		log_skip
+		request_body {
+			max_size 4KB
+		}
+		reverse_proxy 127.0.0.1:8960
+	}
+	handle /l/* {
+		log_skip
 		reverse_proxy 127.0.0.1:8960
 	}
