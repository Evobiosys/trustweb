{
  "name": "trustweb",
  "version": "0.1.0",
  "private": true,
  "license": "LicenseRef-AMPL-1.0 OR AGPL-3.0-or-later",
  "description": "trustweb: a small git-like command line for the TrustWeb record: trust zones, persons, tags, shares, export/import. Local files only, no network.",
  "type": "module",
  "bin": { "trustweb": "bin/trustweb.mjs" },
  "files": ["bin", "scripts/register.mjs", "src"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "test": "node --import ./scripts/register.mjs --test \"test/**/*.test.ts\"",
    "build": "node scripts/lint.mjs"
  },
  "engines": { "node": ">=22.13" },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.0"
  }
}
