{
  "name": "trustweb",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "TrustWeb CLI: trust zones, tags and what they can see, on the share sink's relation store. Local file only, no network.",
  "type": "module",
  "bin": { "trustweb": "bin/trustweb.mjs" },
  "scripts": {
    "test": "node --import ./bin/ts-hooks.mjs --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/lint.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=22.18" }
}
