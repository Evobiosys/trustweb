// One-off generator for src/vrc_di_contexts.ts: copies the JSON-LD context documents verbatim from a local clone of
// berkmancenter/keyring-bifold (Apache-2.0). Usage: npx tsx scripts/gen_vrc_di_contexts.mts <keyring-bifold clone> <sha>
import { writeFileSync } from "node:fs";
import { pathToFileURL } from "node:url";

const [, , clone, sha] = process.argv;
if (!clone || !sha) throw new Error("usage: gen_vrc_di_contexts.mts <keyring-bifold clone> <sha>");
const dir = `${clone}/packages/vrc-contexts/src`;
const load = (f: string): Promise<Record<string, any>> => import(pathToFileURL(`${dir}/${f}`).href);
const v2 = await load("credentialsV2Context.ts");
const reg = await load("dtgRegistryContextV1.ts");
const std = await load("cachedStandardContexts.ts");
const rel = await load("relationshipContext.ts");
const hw = await load("hardwareEvidenceContext.ts");
const keep = ["https://w3id.org/did/v1", "https://www.w3.org/ns/did/v1", "https://w3id.org/security/suites/ed25519-2018/v1"];

const out = `// SPDX-License-Identifier: LicenseRef-AMPL-1.0 OR AGPL-3.0-or-later
// GENERATED by scripts/gen_vrc_di_contexts.mts — do not edit.
// The JSON-LD context documents below are copied verbatim from berkmancenter/keyring-bifold
// packages/vrc-contexts/src (Apache-2.0, https://www.apache.org/licenses/LICENSE-2.0) at ${sha}.
// They are bundled so verification never fetches a context (an unknown context is refused, vrc_di.ts).

export const KEYRING_CONTEXTS_SOURCE_SHA = ${JSON.stringify(sha)};

export const CREDENTIALS_V2_CONTEXT_URL = ${JSON.stringify(v2.CREDENTIALS_V2_CONTEXT_URL)};
export const CREDENTIALS_V2_CONTEXT_DOCUMENT = ${JSON.stringify(v2.CREDENTIALS_V2_CONTEXT_DOCUMENT, null, 2)};

/** Compared byte-exact by the DTG spec; the second @context entry of every DTG credential. */
export const DTG_REGISTRY_CONTEXT_V1_URL = ${JSON.stringify(reg.DTG_REGISTRY_CONTEXT_V1_URL)};
export const DTG_REGISTRY_CONTEXT_V1_SHA256 = ${JSON.stringify(reg.DTG_REGISTRY_CONTEXT_V1_SHA256)};
/** The registry's published bytes (v1 is frozen); sha256 pinned by DTG_REGISTRY_CONTEXT_V1_SHA256. */
export const DTG_REGISTRY_CONTEXT_V1_TEXT = ${JSON.stringify(reg.DTG_REGISTRY_CONTEXT_V1_TEXT)};

/** Contexts a wallet VRC may list third: hardware-attestation evidence (v5+ peers) or the older firstperson DTG context. The evidence itself is not interpreted. */
export const THIRD_CONTEXTS: Record<string, object> = ${JSON.stringify({ [hw.HARDWARE_EVIDENCE_CONTEXT_URL]: hw.HARDWARE_EVIDENCE_CONTEXT_DOCUMENT, [rel.DTG_CONTEXT_URL]: rel.DTG_CONTEXT_DOCUMENT }, null, 2)};

/** DID document contexts the did:peer:0 documents Keyring resolves to are written in. */
export const STANDARD_CONTEXTS: Record<string, object> = ${JSON.stringify(Object.fromEntries(keep.map((k) => [k, std.CACHED_STANDARD_CONTEXTS[k]])), null, 2)};
`;
writeFileSync(new URL("../src/vrc_di_contexts.ts", import.meta.url), out);
